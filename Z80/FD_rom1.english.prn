 797  F55F              ;**** Send 1 BYTE ****
 798  F55F              ;Send contents of A register to PORTA lower 4 bits, 4 bits at a time
 799  F55F              SNDBYTE:
 800  F55F F5           		PUSH	AF
 801  F560 1F           		RRA
 802  F561 1F           		RRA
 803  F562 1F           		RRA
 804  F563 1F           		RRA
 805  F564 E6 0F        		AND		0FH
 806  F566 CD 70 F5     		CALL	SND4BIT
 807  F569 F1           		POP		AF
 808  F56A E6 0F        		AND		0FH
 809  F56C CD 70 F5     		CALL	SND4BIT
 810  F56F C9           		RET
 811  F570
 812  F570              ;**** Send 4 BITS ****
 813  F570              ;Send lower 4 bits of A register
 814  F570              SND4BIT:
 815  F570 D3 D8        		OUT		(0D8H),A
 816  F572 3E 05        		LD		A,05H
 817  F574 D3 DB        		OUT		(0DBH),A    ;PORTC BIT2 <- 1
 818  F576 CD 81 F5     		CALL	F1CHK      ;LOOP until PORTC BIT7 becomes 1
 819  F579 3E 04        		LD		A,04H
 820  F57B D3 DB        		OUT		(0DBH),A    ;PORTC BIT2 <- 0
 821  F57D CD 88 F5     		CALL	F2CHK
 822  F580 C9           		RET
 823  F581
 824  F581              ;**** Check BUSY (1) ****
 825  F581              ; Loop until 82H BIT7 becomes 1
 826  F581 DB DA        F1CHK:	IN		A,(0DAH)
 827  F583 E6 80        		AND		80H        ;PORTC BIT7 = 1?
 828  F585 28 FA        		JR		Z,F1CHK
 829  F587 C9           		RET
 830  F588
 831  F588              ;**** Check BUSY (0) ****
 832  F588              ; Loop until 82H BIT7 becomes 0
 833  F588 DB DA        F2CHK:	IN		A,(0DAH)
 834  F58A E6 80        		AND		80H        ;PORTC BIT7 = 0?
 835  F58C 20 FA        		JR		NZ,F2CHK
 836  F58E C9           		RET
